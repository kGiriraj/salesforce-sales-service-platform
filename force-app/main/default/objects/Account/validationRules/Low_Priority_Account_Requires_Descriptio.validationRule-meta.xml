<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Low_Priority_Account_Requires_Descriptio</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Customer_Priority__c, &quot;Low&quot;),
    ISBLANK(Description)
)</errorConditionFormula>
    <errorMessage>Low Priority Accounts must have a reason in the Description field.</errorMessage>
</ValidationRule>
